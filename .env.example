# Chave da API da Anthropic. Obrigatória. Nunca commite o valor real.
ANTHROPIC_API_KEY=

# Modelo do LLM. Default rápido/barato; trocável por sonnet/opus.
LLM_MODEL=claude-haiku-4-5-20251001

# Streaming NDJSON da resposta da API. Ligado por padrão;
# defina STREAMING_ENABLED=false para a rota responder o JSON de uma vez só.
STREAMING_ENABLED=true
